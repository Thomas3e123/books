{
  "name": "gravity-work-study-lab",
  "version": "0.3.0-beta.1",
  "private": true,
  "description": "Gravity Work Study Lab standalone Windows beta with synchronized expert stack through v63, Guided stability, and durable complete-evidence backup",
  "main": "main.js",
  "author": "Thomas Monroe Books",
  "license": "UNLICENSED",
  "scripts": {
    "sync:expert": "node sync-expert-stack.cjs",
    "verify:expert": "node -e \"const fs=require('fs');const m=JSON.parse(fs.readFileSync('expert/windows-expert-manifest.json','utf8'));if(m.stack!=='v63'||m.count<52||m.windowsBridge!=='durable-evidence-v1'||!m.guidedStability)process.exit(1);console.log('Verified Windows expert stack',m.stack,m.count,'scripts +',m.windowsBridge,'+',m.guidedStability)\"",
    "start": "npm run sync:expert && electron .",
    "build:win": "npm run sync:expert && npm run verify:expert && electron-builder --win nsis zip --x64",
    "pack:win": "npm run sync:expert && npm run verify:expert && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.thomasmonroebooks.gravityworkstudylab",
    "productName": "Gravity Work Study Lab",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "desktop-bridge.js",
      "index.html",
      "styles.css",
      "expert-loader.js",
      "expert/**/*",
      "README.txt",
      "PARITY_STATUS.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {"target":"nsis","arch":["x64"]},
        {"target":"zip","arch":["x64"]}
      ],
      "artifactName": "Gravity_Work_Study_Lab_${version}_${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gravity Work Study Lab"
    }
  }
}
